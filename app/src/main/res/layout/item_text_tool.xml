<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="88dp"
    android:layout_height="44dp"
    android:layout_margin="3dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#111217"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icon_font"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_font"
                android:visibility="gone"
                app:tint="@android:color/white"/>

            <ImageView
                android:id="@+id/icon_color"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_color"
                android:visibility="gone"
                app:tint="@android:color/white"/>

            <ImageView
                android:id="@+id/icon_stroke"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_stroke"
                android:visibility="gone"
                app:tint="@android:color/white"/>

            <ImageView
                android:id="@+id/icon_size"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_scale"
                android:visibility="gone"
                app:tint="@android:color/white"/>

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="Font"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <View
            android:id="@+id/selection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_selected_card"
            android:visibility="gone"/>

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>