<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="@dimen/landing_promotion_height"

    android:layout_marginStart="@dimen/landing_margin"
    android:layout_marginTop="@dimen/landing_card_gap"
    android:layout_marginEnd="@dimen/landing_margin"
    android:layout_marginBottom="@dimen/landing_card_gap"

    android:clickable="false"
    android:focusable="false"

    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="@dimen/landing_radius_medium"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/promotion_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/landing_promotion_padding"
        android:paddingTop="@dimen/landing_promotion_padding_vertical"
        android:paddingEnd="@dimen/landing_promotion_padding"
        android:paddingBottom="@dimen/landing_promotion_padding_vertical">


        <!-- ========================= -->
        <!-- TITLE -->
        <!-- ========================= -->

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:ellipsize="end"

            android:includeFontPadding="false"
            android:maxLines="2"

            android:text="Edit Photos\nLike a Pro"
            android:textColor="@color/landing_navy"
            android:textSize="@dimen/landing_promotion_title_size"
            android:textStyle="bold"

            app:layout_constraintEnd_toStartOf="@id/art_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginTop="4dp"

            android:ellipsize="end"

            android:includeFontPadding="false"
            android:maxLines="2"

            android:text="Crop • Filter • Add Sticker"
            android:textColor="@color/landing_muted"
            android:textSize="@dimen/landing_promotion_subtitle_size"

            app:layout_constraintEnd_toStartOf="@id/art_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title" />


        <!-- ========================= -->
        <!-- FAKE CTA -->
        <!-- ========================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_action"

            android:layout_width="wrap_content"
            android:layout_height="@dimen/landing_promotion_button_height"
            android:layout_marginTop="8dp"
            android:clickable="false"
            android:focusable="false"

            android:minWidth="0dp"
            android:minHeight="0dp"

            android:paddingStart="14dp"
            android:paddingTop="0dp"

            android:paddingEnd="14dp"
            android:paddingBottom="0dp"

            android:text="Explore"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="@dimen/landing_cta_text_size"
            android:textStyle="bold"

            app:backgroundTint="@color/landing_primary"
            app:cornerRadius="@dimen/landing_button_radius"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/landing_action_icon_padding"
            app:iconSize="@dimen/landing_action_icon_size"
            app:iconTint="@android:color/white"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_subtitle" />

        <FrameLayout
            android:id="@+id/art_container"

            android:layout_width="@dimen/landing_promotion_art_width"
            android:layout_height="0dp"

            android:layout_marginStart="10dp"

            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <ImageView
                android:id="@+id/iv_promotion"

                android:layout_width="@dimen/landing_art_size"
                android:layout_height="@dimen/landing_art_size"

                android:layout_gravity="center"

                android:background="@drawable/bg_landing_art_surface"
                android:clipToOutline="true"

                android:contentDescription="@null"

                android:padding="4dp"
                android:scaleType="centerCrop" />


            <!-- Dùng riêng cho Custom Canvas -->
            <LinearLayout
                android:id="@+id/ratio_container"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_gravity="center"

                android:gravity="bottom"
                android:orientation="horizontal"

                android:visibility="gone">


                <TextView
                    android:id="@+id/tv_ratio_one"

                    android:layout_width="@dimen/landing_ratio_width_small"
                    android:layout_height="@dimen/landing_ratio_height_small"

                    android:background="@drawable/bg_landing_art_surface"

                    android:gravity="center"

                    android:text="1:1"
                    android:textColor="@color/landing_navy"
                    android:textSize="@dimen/landing_ratio_text_size"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/tv_ratio_two"

                    android:layout_width="@dimen/landing_ratio_width_medium"
                    android:layout_height="@dimen/landing_ratio_height_medium"

                    android:layout_marginStart="@dimen/landing_ratio_gap"

                    android:background="@drawable/bg_landing_art_surface"

                    android:gravity="center"

                    android:text="3:4"
                    android:textColor="@color/landing_navy"
                    android:textSize="@dimen/landing_ratio_text_size"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/tv_ratio_three"

                    android:layout_width="@dimen/landing_ratio_width_large"
                    android:layout_height="@dimen/landing_ratio_height_large"

                    android:layout_marginStart="@dimen/landing_ratio_gap"

                    android:background="@drawable/bg_landing_art_surface"

                    android:gravity="center"

                    android:text="9:16"
                    android:textColor="@color/landing_navy"
                    android:textSize="@dimen/landing_ratio_text_size"
                    android:textStyle="bold" />

            </LinearLayout>

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
